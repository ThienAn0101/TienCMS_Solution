@{
    Layout = "_LayoutAdmin";
}
@model List<CMS.Data.Entities.Post>

@{
    ViewData["Title"] = "Trang chủ";
}

<div class="container my-5">
    <h2 class="text-center text-danger fw-bold mb-4 text-uppercase">Tin tức mới nhất</h2>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var post in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <img src="@(string.IsNullOrEmpty(post.ImageUrl) ? "https://picsum.photos/400/250" : post.ImageUrl)"
                             class="card-img-top"
                             alt="@post.Title"
                             style="height: 200px; object-fit: cover;">

                        <div class="card-body">
                            <span class="badge bg-primary mb-2">
                                @post.Category?.Name ??
                            </span>

                            <h5 class="card-title fw-bold">
                                <a href="#" class="text-decoration-none text-dark">@post.Title</a>
                            </h5>

                            <a href="#" class="btn btn-sm btn-outline-danger">Đọc tiếp</a>
                        </div>

                        <div class="card-footer bg-transparent border-top-0">
                            <small class="text-muted">
                                Ngày đăng: @(post.CreatedDate != null ? post.CreatedDate.ToString("dd/MM/yyyy") : "13/04/2026")
                            </small>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center">
                <p class="text-muted">Không có bài viết nào hiển thị.</p>
            </div>
        }
    </div>
</div>

<hr />

<div class="text-center my-5">
    <h1 class="display-4">Welcome LÊ THỊ CẨM TIÊN</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>