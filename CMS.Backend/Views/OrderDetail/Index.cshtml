@{
    Layout = "_LayoutAdmin";
}
@model IEnumerable<CMS.Data.Entities.OrderDetail>

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<div class="container mt-4">

    <h2 class="mb-4 text-warning">
        CHI TIẾT ĐƠN HÀNG
    </h2>

    <table class="table table-bordered table-hover">

        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Mã đơn hàng</th>
                <th>Mã sản phẩm</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.Id</td>

                    <td>@item.OrderId</td>

                    <td>@item.ProductId</td>

                    <td>@item.Quantity</td>

                    <td>@item.UnitPrice VNĐ</td>

                </tr>
            }

        </tbody>

    </table>
</div>