@model CMS.Data.Entities.Product

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm sản phẩm mới";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="bi bi-file-earmark-plus"></i> THÊM SẢN PHẨM MỚI</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên sản phẩm / Tên sách:</label>
                            <input asp-for="Name" class="form-control" placeholder="Nhập tên sản phẩm (Ví dụ: Sherlock Holmes...)" required />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Giá bán (VNĐ):</label>
                                <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="Nhập giá bán..." required />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Số lượng tồn kho (Stock):</label>
                                <input asp-for="StockQuantity" type="number" class="form-control" placeholder="Nhập số lượng nhập kho..." required />
                                <span asp-validation-for="StockQuantity" class="text-danger"></span>
                            </div>
                        </div>

                        @*------ TÍCH HỢP CKEDITOR CHO MÔ TẢ SẢN PHẨM ---------------*@
                        <div class="mb-3">
                            <label class="form-label fw-bold">Mô tả sản phẩm:</label>
                            <textarea asp-for="Description" class="form-control" rows="10" placeholder="Viết mô tả sản phẩm tại đây..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Danh mục sản phẩm:</label>
                            <select asp-for="CategoryProductId" class="form-select" asp-items="ViewBag.CategoryProductList" required>
                                <option value="">-- Chọn danh mục sản phẩm --</option>
                            </select>
                            <span asp-validation-for="CategoryProductId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Tải ảnh sản phẩm lên:</label>
                            <input type="file" name="uploadImage" class="form-control" accept="image/*" required />
                            <span asp-validation-for="ImageUrl" class="text-danger"></span>
                        </div>

                        <hr />
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-cloud-arrow-up"></i> Lưu và Nhập hàng
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Quay lại danh sách
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>

    <script>
        // Kích hoạt trình soạn thảo cho thẻ textarea có id là 'Description'
        ClassicEditor
        .create(document.querySelector('#Description'))
        .then(editor => {
        editor.ui.view.editable.element.style.height = '260px'; // Chỉnh chiều cao khung soạn thảo cho cân đối
        })
        .catch(error => {
        console.error(error);
        });
    </script>
}