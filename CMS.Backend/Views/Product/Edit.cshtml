@model CMS.Data.Entities.Product

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="bi bi-pencil-square"></i> CHỈNH SỬA SẢN PHẨM </h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="Id" />

                <div class="row">
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên sản phẩm:</label>
                            <input asp-for="Name" class="form-control" placeholder="Nhập tên sản phẩm..." />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Giá bán (VNĐ):</label>
                            <input asp-for="Price" type="number" class="form-control" placeholder="Ví dụ: 150000" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Mô tả sản phẩm:</label>
                            <textarea asp-for="Description" class="form-control" rows="10" placeholder="Nhập mô tả sản phẩm tại đây..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Danh mục sản phẩm:</label>
                            <select asp-for="CategoryProductId" class="form-select" asp-items="ViewBag.CategoryProductList">
                                <option value="">-- Chọn danh mục sản phẩm --</option>
                            </select>
                            <span asp-validation-for="CategoryProductId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Ảnh sản phẩm hiện tại:</label>
                            <div class="mb-2">
                                @if (!string.IsNullOrEmpty(Model?.ImageUrl))
                                {
                                    <img src="@Model.ImageUrl" class="img-thumbnail d-block" style="max-height: 150px; object-fit: cover;" alt="Product Image" />
                                }
                                else
                                {
                                    <span class="text-muted small">Chưa có ảnh</span>
                                }
                            </div>
                            <label class="form-label fw-bold text-success">Thay đổi ảnh mới (Nếu có):</label>
                            <input type="file" name="uploadImage" class="form-control" accept="image/*" />
                            <span asp-validation-for="ImageUrl" class="text-danger"></span>
                        </div>

                        <hr />
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-cloud-arrow-up"></i> Lưu thay đổi
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Quay lại danh sách
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>

    <script>
        ClassicEditor
        .create(document.querySelector('#Description')) // Đổi từ #Content sang #Description cho khớp Id sản phẩm
        .then(editor => {
        editor.ui.view.editable.element.style.height = '300px';
        })
        .catch(error => {
        console.error(error);
        });
    </script>
}