@{
    Layout = "_LayoutAdmin";
}
@model IEnumerable<CMS.Data.Entities.Product>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold text-uppercase mb-0">
            DANH SÁCH SẢN PHẨM MỚI NHẤT
        </h2>
        <a href="/Product/Create" class="btn btn-success fw-semibold">
            ➕ Thêm sản phẩm mới
        </a>
    </div>
    <div class="row">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm h-100">
                        <img src="@item.ImageUrl" class="card-img-top" alt="Product Image" style="height: 200px; object-fit: cover;">

                        <div class="card-body d-flex flex-column">
                            @if (item.CategoryProduct != null)
                            {
                                <span class="badge bg-success mb-2 align-self-start">@item.CategoryProduct.Name</span>
                            }

                            <h5 class="card-title text-dark fw-bold mb-1">@item.Name</h5>

                            <p class="card-text text-truncate text-muted small mb-2">@item.Description</p>

                            <p class="text-danger fw-bold mt-auto mb-3">Giá: @item.Price.ToString("N0") VNĐ</p>

                            <hr class="mt-0 mb-3" />

                            <div class="d-flex justify-content-between gap-2">
                                <a href="/Product/Details/@item.Id" class="btn btn-sm btn-outline-primary flex-grow-1">
                                    Chi tiết
                                </a>
                                <a href="/Product/Edit/@item.Id" class="btn btn-sm btn-outline-warning text-warning fw-semibold px-3">
                                    Sửa
                                </a>
                                <a href="/Product/Delete/@item.Id" class="btn btn-sm btn-outline-danger text-danger fw-semibold px-3"
                                   onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này không?')">
                                    Xóa
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <h5 class="text-danger fw-bold">Hiện tại hệ thống chưa có sản phẩm nào!</h5>
            </div>
        }
    </div>
</div>